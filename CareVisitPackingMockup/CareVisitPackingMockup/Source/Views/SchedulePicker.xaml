<UserControl x:Class="CareVisitPackingMockup.SchedulePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CareVisitPackingMockup"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style TargetType="{x:Type syncfusion:TimeSlotCell}">
            <Setter Property="Background" Value="#FFE7E7FF" />
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <syncfusion:SfScheduler x:Name="Scheduler"
                                ViewType="Week"
                                FirstDayOfWeek="Monday"
                                ItemsSource="{Binding Appointments}"
                                AppointmentTapped="Scheduler_AppointmentTapped">

            <syncfusion:SfScheduler.AppointmentMapping>
                <syncfusion:AppointmentMapping
                    Id="SchedulerId"
                    Subject="Subject"
                    StartTime="StartTime"
                    EndTime="EndTime"
                    Location="Location"
                    Notes="Notes"
                    AppointmentBackground="AppointmentBackground"
                    Foreground="Foreground" />
            </syncfusion:SfScheduler.AppointmentMapping>

            <syncfusion:SfScheduler.DaysViewSettings>
                <syncfusion:DaysViewSettings StartHour="7" EndHour="18" TimeIntervalSize="-1" />
            </syncfusion:SfScheduler.DaysViewSettings>

        </syncfusion:SfScheduler>
    </Grid>
</UserControl>
